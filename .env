# ============================================================
# Moroccan Job Market Analyzer — Environment Variables
# ============================================================

# --- MinIO (Data Lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# --- PostgreSQL (Data Warehouse) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_market
POSTGRES_USER=jobadmin
POSTGRES_PASSWORD=jobpassword123

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://jobadmin:jobpassword123@postgres:5432/job_market
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nIe3aE=
AIRFLOW__WEBSERVER__SECRET_KEY=moroccan_jobs_secret_2025
AIRFLOW_UID=50000

# --- Kafka ---
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_RAW=jobs-raw
KAFKA_TOPIC_PROCESSED=jobs-processed

# --- Metabase ---
MB_DB_TYPE=postgres
MB_DB_DBNAME=job_market
MB_DB_PORT=5432
MB_DB_USER=jobadmin
MB_DB_PASS=jobpassword123
MB_DB_HOST=postgres

# --- Scraping ---
SCRAPER_DELAY=2.0
SCRAPER_MAX_PAGES=5
